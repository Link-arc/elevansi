# URL utama website setelah deploy (domain custom atau URL Vercel Anda)
NEXT_PUBLIC_SITE_URL=https://elevansidigital.vercel.app

# Optional: Isi GEMINI_API_KEY untuk mengaktifkan jawaban AI dinamis pada asisten chat.
# Tanpa API key pun, asisten chat tetap berjalan otomatis dengan Smart Knowledge Engine bawaan!
GEMINI_API_KEY=

# Nomor WhatsApp bisnis (format internasional tanpa + atau spasi, contoh: 6281234567890)
NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890
